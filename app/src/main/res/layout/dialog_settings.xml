<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/card_bg">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Стартові налаштування"
            android:textColor="#2c3e50"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#7f8c8d"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Close"/>
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Загальний об'єм за замовчуванням (мл):"
        android:textColor="#2c3e50"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etDefaultVolume"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/input_bg"
        android:textColor="#2c3e50"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="numberDecimal"
        android:textSize="15sp"
        android:layout_marginBottom="16dp"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Тип бази VG/PG за замовчуванням:"
        android:textColor="#2c3e50"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinnerDefaultBase"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/spinner_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Нікотин за замовчуванням (мг/мл):"
        android:textColor="#2c3e50"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinnerDefaultNicotine"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/spinner_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginBottom="24dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/btn_save_bg"
        android:textColor="#ffffff"
        android:text="Зберегти"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"/>

</LinearLayout>
