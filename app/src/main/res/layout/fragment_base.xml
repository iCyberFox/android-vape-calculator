<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Змішування основ"
            android:textColor="#34495e"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:elevation="2dp">

            <!-- База 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="База №1"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Об'єм (мл):" android:textColor="#2c3e50" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <EditText android:id="@+id/etVolume1" android:layout_width="match_parent" android:layout_height="40dp"
                android:background="@drawable/input_bg" android:textColor="#2c3e50" android:inputType="numberDecimal"
                android:text="30" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textSize="15sp" android:layout_marginBottom="12dp" android:importantForAutofill="no" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Нікотин (мг/мл):" android:textColor="#2c3e50" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <EditText android:id="@+id/etNic1" android:layout_width="match_parent" android:layout_height="40dp"
                android:background="@drawable/input_bg" android:textColor="#2c3e50" android:inputType="numberDecimal"
                android:text="6" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textSize="15sp" android:layout_marginBottom="12dp" android:importantForAutofill="no" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Співвідношення VG/PG:" android:textColor="#2c3e50" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="0" android:textColor="@color/text_hint" android:textSize="12sp"/>
                <TextView android:id="@+id/tvSlider1Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="60/40" android:textColor="@color/accent" android:textSize="14sp" android:textStyle="bold"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="100" android:textColor="@color/text_hint" android:textSize="12sp" android:gravity="end"/>
            </LinearLayout>

            <SeekBar android:id="@+id/seekBar1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="100" android:progress="40" android:layout_marginBottom="10dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:paddingEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="VG (%)" android:textColor="#7f8c8d" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/etVG1" android:layout_width="match_parent" android:layout_height="40dp"
                        android:background="@drawable/input_bg" android:textColor="#2c3e50" android:inputType="number"
                        android:text="60" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:importantForAutofill="no" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:paddingStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PG (%)" android:textColor="#7f8c8d" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/etPG1" android:layout_width="match_parent" android:layout_height="40dp"
                        android:background="@drawable/input_bg" android:textColor="#2c3e50" android:inputType="number"
                        android:text="40" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>

            <!-- База 2 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="База №2" android:textColor="@color/accent" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Об'єм (мл):" android:textColor="#2c3e50" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <EditText android:id="@+id/etVolume2" android:layout_width="match_parent" android:layout_height="40dp"
                android:background="@drawable/input_bg" android:textColor="#2c3e50" android:inputType="numberDecimal"
                android:text="2" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textSize="15sp" android:layout_marginBottom="12dp" android:importantForAutofill="no" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Нікотин (мг/мл):" android:textColor="#2c3e50" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <EditText android:id="@+id/etNic2" android:layout_width="match_parent" android:layout_height="40dp"
                android:background="@drawable/input_bg" android:textColor="#2c3e50" android:inputType="numberDecimal"
                android:text="100" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textSize="15sp" android:layout_marginBottom="12dp" android:importantForAutofill="no" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Співвідношення VG/PG:" android:textColor="#2c3e50" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="0" android:textColor="@color/text_hint" android:textSize="12sp"/>
                <TextView android:id="@+id/tvSlider2Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0/100" android:textColor="@color/accent" android:textSize="14sp" android:textStyle="bold"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="100" android:textColor="@color/text_hint" android:textSize="12sp" android:gravity="end"/>
            </LinearLayout>

            <SeekBar android:id="@+id/seekBar2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="100" android:progress="100" android:layout_marginBottom="10dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="20dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:paddingEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="VG (%)" android:textColor="#7f8c8d" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/etVG2" android:layout_width="match_parent" android:layout_height="40dp"
                        android:background="@drawable/input_bg" android:textColor="#2c3e50" android:inputType="number"
                        android:text="0" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:importantForAutofill="no" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:paddingStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PG (%)" android:textColor="#7f8c8d" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/etPG2" android:layout_width="match_parent" android:layout_height="40dp"
                        android:background="@drawable/input_bg" android:textColor="#2c3e50" android:inputType="number"
                        android:text="100" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/btn_calculate_bg"
                android:textColor="#ffffff"
                android:text="Розрахувати"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#3498db"
                android:textSize="10sp"
                android:layout_gravity="end"/>
        </LinearLayout>

        <!-- Результат -->
        <LinearLayout android:id="@+id/resultContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/result_bg"
            android:paddingStart="24dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="16dp"
            android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:visibility="gone">

            <TextView android:id="@+id/tvResultsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Результати:" android:textColor="#2980b9" android:textSize="16sp"
                android:textStyle="bold" android:layout_marginBottom="12dp"/>

            <TextView android:id="@+id/tvResultContent" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#2c3e50" android:textSize="14sp" android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
