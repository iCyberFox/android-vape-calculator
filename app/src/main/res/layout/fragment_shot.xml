<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Флейвор шот"
            android:textColor="#34495e"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg" android:padding="20dp" android:layout_marginBottom="12dp" android:elevation="2dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Об'єм шоту (мл):" android:textColor="#2c3e50" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <EditText android:id="@+id/etShotVolume" android:layout_width="match_parent" android:layout_height="40dp"
                android:background="@drawable/input_bg" android:textColor="#2c3e50" android:inputType="numberDecimal"
                android:text="10" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textSize="15sp" android:layout_marginBottom="12dp" android:importantForAutofill="no" />

            <TextView android:id="@+id/tvTotalPercent" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Сумарний %: 0%" android:textColor="#7f8c8d" android:textSize="13sp" android:layout_marginBottom="10dp"/>

            <LinearLayout android:id="@+id/flavorsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAddFlavor" android:layout_width="match_parent" android:layout_height="45dp"
                android:background="@drawable/btn_add_bg" android:textColor="#ffffff" android:text="+ Додати ароматизатор"
                android:textSize="14sp" android:textAllCaps="false" android:layout_marginTop="6dp"/>

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCalculate" android:layout_width="match_parent" android:layout_height="45dp"
                android:background="@drawable/btn_calculate_bg" android:textColor="#ffffff" android:text="Розрахувати"
                android:textSize="16sp" android:textAllCaps="false" android:fontFamily="sans-serif-medium" android:layout_marginTop="12dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/resultContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/result_bg"
            android:paddingStart="24dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="16dp"
            android:layout_marginBottom="12dp" android:visibility="gone">

            <TextView android:id="@+id/tvResultsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Результати:" android:textColor="#2980b9" android:textSize="16sp"
                android:textStyle="bold" android:layout_marginBottom="12dp"/>

            <TextView android:id="@+id/tvResultContent" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#2c3e50" android:textSize="14sp" android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#3498db"
            android:textSize="10sp"
            android:layout_gravity="end"
            android:layout_marginBottom="20dp"/>
    </LinearLayout>
</ScrollView>
